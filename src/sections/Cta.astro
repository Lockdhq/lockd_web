---
/**
 * OPEN QUESTION (BRIEF.md §9): waitlist, TestFlight, or App Store?
 * ASSUMPTION: waitlist. No store or TestFlight URL exists in any source, and
 * shipping a fake one would be an invented claim.
 *
 * Posts to /api/waitlist by default (see src/data/site.ts) and enhances to a
 * fetch so the page doesn't navigate. The mailto link only shows up if
 * PUBLIC_WAITLIST_ENDPOINT is explicitly set to an empty string — a manual
 * escape hatch, not the default path.
 */
import { site, waitlistEndpoint } from '../data/site';

const hasEndpoint = waitlistEndpoint.length > 0;
const mailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent('Waitlist')}&body=${encodeURIComponent("Count me in for Lockd when it opens up.")}`;
---

<section id="waitlist" class="section cta">
  <div class="container">
    <div class="cta-card" data-reveal>
      <p class="eyebrow">First Locks</p>
      <h2 class="t-display cta-title">lock it in</h2>
      <p class="t-subhead cta-sub">
        Lockd is still being built. Leave your email and we'll tell you the day you can set
        your first Lock — nothing before that.
      </p>

      {
        hasEndpoint ? (
          <form class="cta-form" action={waitlistEndpoint} method="post" data-waitlist>
            <div class="cta-field">
              <label class="visually-hidden" for="waitlist-email">
                Email address
              </label>
              <input
                id="waitlist-email"
                type="email"
                name="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@example.com"
                aria-describedby="waitlist-privacy"
              />
              <button type="submit" class="btn btn-accent btn-lg">Join the waitlist</button>
            </div>
            <p class="cta-status t-caption" role="status" aria-live="polite" data-waitlist-status />
          </form>
        ) : (
          <p class="cta-form">
            <a class="btn btn-accent btn-lg" href={mailto}>
              Email us to join the waitlist
            </a>
          </p>
        )
      }

      <p id="waitlist-privacy" class="t-legal cta-privacy">
        We'll only use your email to tell you when Lockd opens up. Nothing else, and you can
        ask us to delete it at any time at {site.contactEmail}.
      </p>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-waitlist]');
  const status = document.querySelector<HTMLElement>('[data-waitlist-status]');

  form?.addEventListener('submit', async (event) => {
    if (!form.action) return;
    event.preventDefault();

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (status) {
      status.textContent = 'Sending…';
      status.dataset.state = 'pending';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) throw new Error(String(response.status));

      form.reset();
      if (status) {
        status.textContent = "You're on the list. We'll be in touch when Lockd opens up.";
        status.dataset.state = 'ok';
      }
    } catch {
      if (status) {
        status.textContent =
          "That didn't go through. Try again, or email hello@lockd.app and we'll add you by hand.";
        status.dataset.state = 'error';
      }
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .cta-card {
    position: relative;
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-hero);
    border: 1px solid var(--border-strong);
    background:
      radial-gradient(90% 120% at 50% 0%, rgba(219, 253, 0, 0.09), transparent 62%),
      var(--surface);
    text-align: center;
    overflow: hidden;
  }

  .cta-title {
    margin-top: var(--space-4);
  }

  .cta-sub {
    margin: var(--space-5) auto 0;
    max-width: 46ch;
    color: var(--text-muted);
  }

  .cta-form {
    margin: var(--space-7) auto 0;
    max-width: 30rem;
  }

  .cta-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cta-field input {
    width: 100%;
    padding: 15px 18px;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--control);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-input);
    transition: border-color var(--duration-fast) var(--ease-move);
  }

  .cta-field input::placeholder {
    color: var(--text-dim);
  }

  .cta-field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: transparent;
  }

  .cta-status:empty {
    display: none;
  }

  .cta-status {
    margin-top: var(--space-4);
  }

  .cta-status[data-state='ok'] {
    color: var(--accent);
  }

  .cta-status[data-state='error'] {
    color: var(--danger-soft);
  }

  .cta-privacy {
    margin: var(--space-6) auto 0;
    max-width: 44ch;
    color: var(--text-dim);
  }

  @media (min-width: 560px) {
    .cta-card {
      padding: var(--space-9) var(--space-8);
    }

    .cta-field {
      flex-direction: row;
    }

    .cta-field .btn {
      flex: none;
    }
  }
</style>
