---
import Wordmark from './Wordmark.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <Wordmark href="/" />

    <nav aria-label="Page sections" class="header-nav">
      <a href="#how-it-works">How it works</a>
      <a href="#verification">Verification</a>
      <a href="#faq">Questions</a>
    </nav>

    <a class="btn btn-accent btn-sm header-cta" href="#waitlist">Join the waitlist</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 60px;
  }

  .header-nav {
    display: none;
    margin-inline-start: auto;
    gap: var(--space-5);
  }

  .header-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--duration-fast) var(--ease-move);
  }

  .header-nav a:hover {
    color: var(--text);
  }

  .header-cta {
    margin-inline-start: auto;
  }

  @media (min-width: 800px) {
    .header-nav {
      display: flex;
    }

    .header-cta {
      margin-inline-start: 0;
    }
  }
</style>
