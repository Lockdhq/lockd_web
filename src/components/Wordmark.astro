---
/**
 * Wordmark.
 *
 * OPEN QUESTION (BRIEF.md §9): is the wordmark locked?
 * ASSUMPTION: not locked. Rendered as styled text from the type system rather
 * than an image, so real artwork can drop in without touching layout.
 *
 * The mobile app cycles brand colours (orange/blue/mint) in its logo. That is
 * deliberately NOT reproduced here: AGENTS.md non-negotiable #5 is one accent on
 * near-black, and on a page this size a second hue would cost more than it adds.
 */
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['wordmark', className]}
  {...href ? { href } : {}}
  {...href ? { 'aria-label': 'Lockd — home' } : {}}
>
  lockd<span class="dot" aria-hidden="true">.</span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
  }

  .dot {
    color: var(--accent);
  }
</style>
